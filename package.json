{
  "name": "aurora-lab-equipment-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "seed": "node server/seed.js",
    "dev:all": "node scripts/dev.mjs",
    "test:api": "node scripts/api-test.mjs",
    "check:data": "node scripts/check-data.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "node --test \"tests/rules/*.test.mjs\"",
    "test:component": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:rules && npm run test:component && npm run test:api",
    "verify": "npm run lint && npm run check:data && npm test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "ali-oss": "^6.23.0",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "element-plus": "^2.13.7",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
