# ============================================================
# 极光实验室 · AI 服务配置
# 复制本文件为 .env 后填入真实 Key（.env 已被 git 忽略）
# ============================================================

# 通义千问（默认主用）
QWEN_API_KEY=
QWEN_MODEL=qwen-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek（备用，模型名必须是 deepseek-chat）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 登录 Token 签名密钥（留空时启动自动生成随机密钥，重启后登录态失效；生产环境务必配置固定值）
LAB_SECRET=

# 跨域白名单（逗号分隔，仅前后端分域部署时需要）
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 部署在 Nginx 等反向代理之后时设为 1，否则保持为空
TRUST_PROXY=

# QQ 邮箱 SMTP（用于注册 / 找回密码验证码）
# SMTP_PASS 是 QQ 邮箱「设置 → 账户 → 生成授权码」得到的 16 位授权码，不是 QQ 密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM_NAME=极光实验室

# 阿里云 OSS（设备图片、附件；未配置时自动回退本地磁盘）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-chengdu
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_PUBLIC_BASE_URL=
OSS_PREFIX=lab

# 本地回退存储最多保留的图片数量（超过后拒绝新上传）
UPLOAD_MAX_FILES=500

# Web Push（浏览器通知）
# 留空时首次启动自动生成密钥并保存到 server/data/vapid.json（已排除在提交包外）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:你的邮箱@qq.com
